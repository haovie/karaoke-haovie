# Server port
PORT=3001

# Public base URL — must be accessible from phones on same LAN (NOT localhost)
# Example: http://192.168.1.100:5173
PUBLIC_BASE_URL=http://192.168.1.100:5173

# YouTube Data API v3 key
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# CORS origin for the web app
CORS_ORIGIN=http://192.168.1.100:5173

# Search cache TTL in milliseconds (default: 6 hours)
SEARCH_CACHE_TTL=21600000
